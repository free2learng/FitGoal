generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id             String   @id @db.Uuid
  email          String?
  fullName       String?  @map("full_name")
  avatarUrl      String?  @map("avatar_url")
  role           String   @default("user")
  goal           String?
  age            Int?
  heightCm       Int?     @map("height_cm")
  weightKg       Decimal? @map("weight_kg")
  fitnessLevel   String?  @map("fitness_level")
  equipment      String?
  dietPreference String?  @map("diet_preference")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @default(now()) @map("updated_at")

  @@map("profiles")
}

model Workout {
  id              String     @id
  title           String
  level           String
  goal            String
  day             Int
  durationMinutes Int        @map("duration_minutes")
  focus           String
  exercises       Exercise[]

  @@map("workouts")
}

model Exercise {
  id          String  @id @default(uuid()) @db.Uuid
  workoutId   String  @map("workout_id")
  workout     Workout @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  name        String
  sets        Int
  reps        String
  restSeconds Int     @map("rest_seconds")
  tutorialUrl String  @map("tutorial_url")
  position    Int

  @@map("exercises")
}

model WorkoutLog {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  workoutId    String?   @map("workout_id")
  status       String
  scheduledFor DateTime  @map("scheduled_for") @db.Date
  completedAt  DateTime? @map("completed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("workout_logs")
}

model ProgressEntry {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  entryDate         DateTime @map("entry_date") @db.Date
  weightKg          Decimal  @map("weight_kg")
  waistCm           Decimal  @map("waist_cm")
  calories          Int
  workoutsCompleted Int      @default(0) @map("workouts_completed")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("progress_entries")
}

model NutritionFood {
  id                   String   @id
  name                 String
  category             String
  subcategory          String
  servingSize          Decimal  @map("serving_size")
  servingUnit          String   @map("serving_unit")
  calories             Int
  protein              Decimal
  carbs                Decimal
  fats                 Decimal
  sugar                Decimal  @default(0)
  fibre                Decimal  @default(0)
  sodium               Decimal  @default(0)
  caffeineMg           Decimal? @map("caffeine_mg")
  vitamins             String[]
  minerals             String[]
  tags                 String[]
  synonyms             String[]
  commonServingOptions Json     @map("common_serving_options")
  preparationMethod    String   @map("preparation_method")
  isDrink              Boolean  @default(false) @map("is_drink")
  isCustom             Boolean  @default(false) @map("is_custom")
  source               String
  verifiedStatus       String   @map("verified_status")
  externalProvider     String?  @map("external_provider")
  externalId           String?  @map("external_id")
  barcode              String?
  brandName            String?  @map("brand_name")
  fitnessBenefit       String   @map("fitness_benefit")
  mealUse              String   @map("meal_use")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("nutrition_foods")
}

model UserCustomFood {
  id                   String   @id
  userId               String   @map("user_id") @db.Uuid
  name                 String
  category             String
  subcategory          String
  servingSize          Decimal  @map("serving_size")
  servingUnit          String   @map("serving_unit")
  calories             Int
  protein              Decimal  @default(0)
  carbs                Decimal  @default(0)
  fats                 Decimal  @default(0)
  sugar                Decimal  @default(0)
  fibre                Decimal  @default(0)
  sodium               Decimal  @default(0)
  caffeineMg           Decimal? @map("caffeine_mg")
  vitamins             String[]
  minerals             String[]
  tags                 String[]
  synonyms             String[]
  commonServingOptions Json     @map("common_serving_options")
  preparationMethod    String   @map("preparation_method")
  isDrink              Boolean  @default(false) @map("is_drink")
  source               String   @default("custom")
  verifiedStatus       String   @default("user") @map("verified_status")
  createdAt            DateTime @default(now()) @map("created_at")

  @@map("user_custom_foods")
}

model FavoriteFood {
  userId    String   @map("user_id") @db.Uuid
  foodId    String   @map("food_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@id([userId, foodId])
  @@map("favorite_foods")
}

model MealTemplate {
  id                String
  name              String
  category          String
  mealType          String   @map("meal_type")
  ingredientFoodIds String[] @map("ingredient_food_ids")
  tags              String[]
  description       String

  @@id([id])
  @@map("meal_templates")
}

model FoodLog {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  logDate           DateTime @map("log_date") @db.Date
  status            String
  mealType          String   @map("meal_type")
  foodId            String?  @map("food_id")
  foodName          String   @map("food_name")
  serving           String
  servingMultiplier Decimal  @default(1) @map("serving_multiplier")
  calories          Int
  protein           Decimal  @default(0)
  carbs             Decimal  @default(0)
  fats              Decimal  @default(0)
  sugar             Decimal  @default(0)
  fibre             Decimal  @default(0)
  sodium            Decimal  @default(0)
  caffeineMg        Decimal? @map("caffeine_mg")
  keyMicronutrients String[] @map("key_micronutrients")
  source            String
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("food_logs")
}

model HydrationLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  logDate   DateTime @map("log_date") @db.Date
  drinkType String   @map("drink_type")
  amountMl  Int      @map("amount_ml")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("hydration_logs")
}

model HydrationAdjustment {
  userId         String   @map("user_id") @db.Uuid
  adjustmentDate DateTime @map("adjustment_date") @db.Date
  adjustment     String
  createdAt      DateTime @default(now()) @map("created_at")

  @@id([userId, adjustmentDate, adjustment])
  @@map("hydration_adjustments")
}

model UserStateSnapshot {
  userId             String   @id @map("user_id") @db.Uuid
  state              Json
  performanceSummary Json     @map("performance_summary")
  updatedAt          DateTime @default(now()) @map("updated_at")

  @@map("user_state_snapshots")
}
